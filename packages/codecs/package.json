{
  "name": "@siteinquisition/codecs",
  "version": "1.0.0-beta.1",
  "description": "Chainable, reversible encoders and decoders shared by every part of SiteInquisition.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsonpath": {
      "types": "./dist/jsonpath.d.ts",
      "default": "./dist/jsonpath.js"
    },
    "./protocols": {
      "types": "./dist/protocols.d.ts",
      "default": "./dist/protocols.js"
    },
    "./protobuf": {
      "types": "./dist/protobuf.d.ts",
      "default": "./dist/protobuf.js"
    },
    "./regionedit": {
      "types": "./dist/regionedit.d.ts",
      "default": "./dist/regionedit.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
