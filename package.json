{
  "name": "siteinquisition",
  "private": true,
  "version": "0.0.0",
  "description": "Intercepting proxy, built-in browser and replay toolkit for testing unfinished websites, APIs and IoT devices.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "siq": "node packages/cli/dist/main.js",
    "app": "pnpm --filter @siteinquisition/app start"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
