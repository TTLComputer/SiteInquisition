{
  "name": "siteinquisition",
  "private": true,
  "version": "1.0.0",
  "description": "Intercepting proxy, built-in browser and replay toolkit for testing unfinished websites, APIs and IoT devices.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @siteinquisition/devkit build && SIQ_KEYRING=none node packages/devkit/dist/test/cli.js",
    "test:watch": "pnpm --filter @siteinquisition/devkit build && node packages/devkit/dist/test/cli.js --watch",
    "siq": "node packages/cli/dist/main.js",
    "app": "pnpm --filter @siteinquisition/app start",
    "package": "pnpm --filter @siteinquisition/devkit build && node packages/devkit/dist/package/cli.js",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@siteinquisition/devkit": "workspace:*",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  },
  "siqTest": {
    "include": [
      "packages/*/test/**/*.test.ts"
    ],
    "timeout": 20000,
    "hookTimeout": 20000,
    "alias": {
      "@siteinquisition/codecs/jsonpath": "packages/codecs/src/jsonpath.ts",
      "@siteinquisition/codecs": "packages/codecs/src/index.ts",
      "@siteinquisition/core": "packages/core/src/index.ts"
    }
  }
}
